    },
    {
      "id": "llm_classify",
      "type": "LLM",
      "title": "意图分类",
      "prompt_ref": "docs/system-prompts.md#§2",
      "input": "userinput.query",
      "memory": true,
      "temperature_hint": "low",
      "outputs": [
        "text"
      ],
      "alternative": {
        "type": "Question Classifier",
        "note": "Define 5 classes using label definitions from §2; put HV-priority and follow-up rules in Instructions; removes need for if_route. llm_refusal then cannot read llm_classify.text: insert the Question Classifier's class_name output instead (see workflow-nodes.md §3.3)."
      }
    },
    {
      "id": "if_route",
      "type": "If-Else",
      "title": "分流",
      "cases": [
        {
          "case": "IF",
          "variable": "llm_classify.text",
          "operator": "contains",
          "value": "unsafe_hv",
          "target": "llm_refusal",
          "handle": "unsafe_hv"
        },
        {
          "case": "ELIF",
          "variable": "llm_classify.text",
          "operator": "contains",
          "value": "fault",
          "target": "pe_slots",
          "handle": "fault"
        },
        {
          "case": "ELIF",
          "variable": "llm_classify.text",
          "operator": "contains",
          "value": "knowledge",
          "target": "kr_knowledge",
          "handle": "knowledge"
        },
        {
          "case": "ELIF",
          "variable": "llm_classify.text",
          "operator": "contains",
          "value": "english",
          "target": "kr_glossary",
          "handle": "english"
        },
        {
          "case": "ELSE",
          "target": "llm_refusal",
          "note": "out_of_scope or unexpected output",
          "handle": "else"
        }
      ]
    },
    {
