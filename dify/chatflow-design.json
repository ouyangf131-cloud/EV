    {
      "name": "model_year",
      "type": "string",
      "default": ""
    },
    {
      "name": "powertrain",
      "type": "string",
      "default": ""
    },
    {
      "name": "mileage",
      "type": "string",
      "default": ""
    },
    {
      "name": "power_state",
      "type": "string",
      "default": ""
    },
    {
      "name": "symptom",
      "type": "string",
      "default": ""
    },
    {
      "name": "warning_info",
      "type": "string",
      "default": ""
