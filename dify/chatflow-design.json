      "type": "Parameter Extractor",
      "title": "槽位提取",
      "input": "userinput.query",
      "instruction_ref": "docs/system-prompts.md#§3",
      "parameters": [
        {
          "name": "brand",
          "type": "string",
          "required": false
        },
        {
          "name": "vehicle_model",
          "type": "string",
          "required": false
        },
        {
          "name": "model_year",
          "type": "string",
          "required": false
        },
        {
          "name": "powertrain",
          "type": "string",
          "required": false
        },
        {
          "name": "mileage",
          "type": "string",
          "required": false
        },
        {
          "name": "power_state",
          "type": "string",
          "required": false
        },
        {
          "name": "symptom",
          "type": "string",
          "required": false
        },
        {
          "name": "warning_info",
          "type": "string",
          "required": false
        },
        {
          "name": "recent_events",
          "type": "string",
