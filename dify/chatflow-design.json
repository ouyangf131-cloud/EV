        "__reason"
      ]
    },
    {
      "id": "code_merge_slots",
      "type": "Code",
      "title": "合并槽位",
      "language": "python3",
      "purpose": "Merge pe_slots output with old conversation values. (1) __is_success==0 -> keep ALL old values. (2) Blank/null new value -> keep old. (3) Non-definite answers (不确定/不知道/未知/unknown/不清楚/没注意 ..., case- and whitespace-insensitive, whole-value match) are normalized to '不确定'; power_state outside {能READY, 不能READY, 12V都没电} (after alias mapping) is also normalized to '不确定'. (4) A '不确定' new value never overwrites a confirmed old value; it may only fill an empty slot. (5) Also outputs fault_query = brand + vehicle_model + powertrain + power_state + symptom + warning_info (non-empty, non-uncertain) for kr_fault.",
      "inputs": [
        {
          "name": "is_success",
          "source": "pe_slots.__is_success"
        },
        {
          "name": "new_brand",
          "source": "pe_slots.brand"
        },
        {
          "name": "new_vehicle_model",
          "source": "pe_slots.vehicle_model"
        },
        {
          "name": "new_model_year",
          "source": "pe_slots.model_year"
        },
        {
          "name": "new_powertrain",
          "source": "pe_slots.powertrain"
        },
        {
          "name": "new_mileage",
          "source": "pe_slots.mileage"
        },
        {
          "name": "new_power_state",
          "source": "pe_slots.power_state"
        },
        {
          "name": "new_symptom",
          "source": "pe_slots.symptom"
        },
        {
          "name": "new_warning_info",
          "source": "pe_slots.warning_info"
        },
        {
          "name": "new_recent_events",
          "source": "pe_slots.recent_events"
        },
        {
          "name": "old_brand",
          "source": "conversation.brand"
        },
        {
          "name": "old_vehicle_model",
          "source": "conversation.vehicle_model"
        },
        {
          "name": "old_model_year",
          "source": "conversation.model_year"
        },
        {
          "name": "old_powertrain",
          "source": "conversation.powertrain"
        },
        {
          "name": "old_mileage",
          "source": "conversation.mileage"
        },
        {
          "name": "old_power_state",
          "source": "conversation.power_state"
        },
        {
          "name": "old_symptom",
          "source": "conversation.symptom"
        },
        {
          "name": "old_warning_info",
          "source": "conversation.warning_info"
        },
        {
          "name": "old_recent_events",
          "source": "conversation.recent_events"
        }
      ],
      "outputs": [
        {
          "name": "brand",
          "type": "string"
        },
        {
          "name": "vehicle_model",
          "type": "string"
        },
        {
          "name": "model_year",
          "type": "string"
        },
        {
          "name": "powertrain",
          "type": "string"
        },
        {
          "name": "mileage",
          "type": "string"
        },
        {
          "name": "power_state",
          "type": "string"
        },
        {
          "name": "symptom",
          "type": "string"
        },
        {
          "name": "warning_info",
          "type": "string"
        },
        {
          "name": "recent_events",
          "type": "string"
        },
        {
          "name": "fault_query",
          "type": "string"
        }
      ],
      "code": "import re\n\nSLOTS = [\"brand\", \"vehicle_model\", \"model_year\", \"powertrain\", \"mileage\",\n         \"power_state\", \"symptom\", \"warning_info\", \"recent_events\"]\n\nUNCERTAIN = \"不确定\"\n# power_state 只允许 3 个确定值；下面是常见同义写法（去空格/标点、转小写后整句匹配）\nPOWER_STATES = {\n    \"能READY\": [\"能ready\", \"能进入ready\", \"可以ready\", \"可以进入ready\", \"ready正常\",\n                \"能正常ready\", \"可以正常ready\", \"正常ready\", \"ready能亮\", \"ready亮\"],\n    \"不能READY\": [\"不能ready\", \"不能进入ready\", \"进不了ready\", \"无法ready\", \"无法进入ready\",\n                \"上不了ready\", \"ready不亮\", \"没有ready\"],\n    \"12V都没电\": [\"12v都没电\", \"12v没电\", \"全车没电\"],\n}\n\n# 表示\"不确定/不知道\"的说法（去掉空格和标点、转小写后整句匹配）\n_UNCERTAIN_WORDS = {\n    \"不确定\", \"不太确定\", \"不知道\", \"不太知道\", \"不清楚\", \"不太清楚\", \"未知\", \"不详\",\n    \"没注意\", \"没注意到\", \"没留意\", \"不记得\", \"记不清\", \"忘了\", \"说不清\", \"不晓得\",\n    \"待确认\", \"待定\", \"待核实\", \"unknown\", \"unsure\", \"notsure\", \"idk\",\n    \"dontknow\", \"idontknow\", \"n/a\", \"na\",\n}\n# 口语变体：如\"我也不太清楚呢\"\"没注意到啊\"\n_UNCERTAIN_RE = re.compile(r\"^(我)?(也)?(不太|不|没)(确定|知道|清楚|记得|注意|注意到|留意|晓得)(了|呢|啊|哦|耶)?$\")\n_EMPTY_WORDS = {\"null\", \"none\", \"undefined\", \"nil\"}\n_STRIP_RE = re.compile(r\"[\\s。，,\\.！!？?~～、（）()\\\"'“”‘’：:；;]+\")\n\n\ndef _clean(v):\n    if v is None:\n        return \"\"\n    return str(v).strip()\n\n\ndef _key(v):\n    return _STRIP_RE.sub(\"\", v).lower()\n\n\ndef _normalize(slot, v):\n    \"\"\"返回 (值, 是否不确定)。空值返回 (\"\", False)。\"\"\"\n    v = _clean(v)\n    k = _key(v)\n    if not k or k in _EMPTY_WORDS:\n        return \"\", False\n    if k in _UNCERTAIN_WORDS or _UNCERTAIN_RE.match(k):\n        return UNCERTAIN, True\n    if slot == \"power_state\":\n        for name, aliases in POWER_STATES.items():\n            if k in aliases:\n                return name, False\n        # 不在枚举里的 power_state 一律视为不确定（宁可再问一次）\n        return UNCERTAIN, True\n    return v, False\n\n\ndef main(is_success,\n         new_brand, new_vehicle_model, new_model_year, new_powertrain, new_mileage,\n         new_power_state, new_symptom, new_warning_info, new_recent_events,\n         old_brand, old_vehicle_model, old_model_year, old_powertrain, old_mileage,\n         old_power_state, old_symptom, old_warning_info, old_recent_events) -> dict:\n    args = dict(locals())\n    # 提取失败（__is_success == 0）时，不采用任何新值\n    failed = _clean(is_success).lower() in (\"0\", \"0.0\", \"false\")\n    out = {}\n    for k in SLOTS:\n        old, old_unsure = _normalize(k, args.get(\"old_\" + k))\n        new, new_unsure = _normalize(k, args.get(\"new_\" + k))\n        if failed or not new:\n            out[k] = old                      # 新值为空/提取失败 → 保留旧值\n        elif new_unsure and old and not old_unsure:\n            out[k] = old                      # \"不确定\"不能覆盖已确定的旧值\n        else:\n            out[k] = new                      # 其余情况用新值（\"不确定\"只能填空位）\n    parts = [out[k] for k in (\"brand\", \"vehicle_model\", \"powertrain\", \"power_state\",\n                              \"symptom\", \"warning_info\") if out[k] and out[k] != UNCERTAIN]\n    out[\"fault_query\"] = \" \".join(parts)      # 供 kr_fault 检索用（NB5）\n    return out\n",
      "code_ref": "docs/workflow-nodes.md#2.1",
      "code_file": "dify/code_merge_slots.py",
      "tests": "tests/test_code_merge_slots.py (offline python3 unittest; not run in Dify)",
      "note": "Design only. Merge logic checked offline by tests/test_code_merge_slots.py with plain python3; NOT run in Dify (sandbox behaviour such as 'import re' and the real type of __is_success must be verified in Dify)."
    },
    {
      "id": "va_slots",
      "type": "Variable Assigner",
      "title": "保存槽位",
      "assignments": [
        {
          "variable": "conversation.brand",
          "operation": "overwrite",
          "source": "code_merge_slots.brand"
        },
        {
          "variable": "conversation.vehicle_model",
          "operation": "overwrite",
          "source": "code_merge_slots.vehicle_model"
        },
        {
          "variable": "conversation.model_year",
          "operation": "overwrite",
          "source": "code_merge_slots.model_year"
        },
        {
          "variable": "conversation.powertrain",
          "operation": "overwrite",
          "source": "code_merge_slots.powertrain"
        },
        {
          "variable": "conversation.mileage",
          "operation": "overwrite",
          "source": "code_merge_slots.mileage"
        },
        {
          "variable": "conversation.power_state",
          "operation": "overwrite",
          "source": "code_merge_slots.power_state"
        },
        {
          "variable": "conversation.symptom",
          "operation": "overwrite",
          "source": "code_merge_slots.symptom"
        },
        {
          "variable": "conversation.warning_info",
          "operation": "overwrite",
          "source": "code_merge_slots.warning_info"
        },
        {
          "variable": "conversation.recent_events",
          "operation": "overwrite",
          "source": "code_merge_slots.recent_events"
        }
      ],
      "note": "All 9 rows Overwrite with the merged result from code_merge_slots (not directly from pe_slots)."
    },
    {
      "id": "if_slots",
      "type": "If-Else",
      "title": "信息是否齐全",
      "cases": [
        {
          "case": "IF",
          "logic": "AND",
          "conditions": [
            {
              "variable": "conversation.brand",
              "operator": "is not empty"
            },
            {
              "variable": "conversation.brand",
              "operator": "not contains",
              "value": "不确定"
            },
            {
              "variable": "conversation.vehicle_model",
              "operator": "is not empty"
            },
            {
              "variable": "conversation.vehicle_model",
              "operator": "not contains",
              "value": "不确定"
            },
            {
              "variable": "conversation.power_state",
              "operator": "is not empty"
            },
            {
              "variable": "conversation.power_state",
              "operator": "not contains",
              "value": "不确定"
            },
            {
              "variable": "conversation.symptom",
              "operator": "is not empty"
            },
            {
              "variable": "conversation.symptom",
              "operator": "not contains",
              "value": "不确定"
            }
          ],
          "target": "kr_fault",
          "note": "Required slot = non-empty AND not containing '不确定' (code_merge_slots normalizes all non-definite answers to '不确定'). No ask-count cap: if the user can never answer, the flow stays in intake (deliberate; §4 rule 7 then suggests a dealer/qualified technician).",
          "handle": "complete"
        },
        {
          "case": "ELSE",
          "target": "kr_intake",
          "handle": "else"
        }
      ]
    },
    {
      "id": "kr_intake",
      "type": "Knowledge Retrieval",
      "title": "问诊清单检索（可选）",
      "query": "userinput.query",
      "knowledge": [
        "ev-knowledge"
      ],
      "optional": true,
      "metadata_filter_hint": "01-fault-intake only (optional)",
      "top_k_hint": "3-5, untested",
      "outputs": [
        "result"
      ]
    },
    {
      "id": "llm_intake",
      "type": "LLM",
      "title": "信息收集",
      "context": "kr_intake.result",
      "memory": true,
      "prompt_ref": "docs/system-prompts.md#§4",
      "outputs": [
        "text"
      ]
    },
    {
      "id": "kr_fault",
      "type": "Knowledge Retrieval",
      "title": "排查资料检索",
      "query": "code_merge_slots.fault_query",
      "knowledge": [
        "ev-knowledge"
      ],
      "top_k_hint": "3-5, untested",
      "outputs": [
        "result"
      ],
      "query_note": "NB5: concatenated slots instead of this turn's raw message (multi-turn replies like '海豚，2022 年' retrieve poorly)."
    },
    {
      "id": "llm_troubleshoot",
      "type": "LLM",
      "title": "排查方向",
      "context": "kr_fault.result",
      "memory": true,
      "prompt_ref": "docs/system-prompts.md#§5",
      "outputs": [
        "text"
      ]
    },
    {
