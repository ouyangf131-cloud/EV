{
  "_format": "EV structured design JSON (custom schema 'ev-chatflow-design/v1'). NOT a Dify DSL file and NOT importable via Dify 'Import App'. Build manually following dify/import-guide.md.",
  "_status": "Design only. Not deployed. Not run in Dify (local or cloud).",
  "_disclaimer": "教学示例，使用前以现行车厂手册与法规为准。",
  "_doc_sources": {
    "checked_on": "2026-10-26",
    "workflow_chatflow": "https://docs.dify.ai/en/self-host/use-dify/build/workflow-chatflow",
    "knowledge_retrieval": "https://docs.dify.ai/en/self-host/use-dify/nodes/knowledge-retrieval",
    "question_classifier": "https://docs.dify.ai/en/self-host/use-dify/nodes/question-classifier",
    "ifelse": "https://docs.dify.ai/en/self-host/use-dify/nodes/ifelse",
    "variable_assigner": "https://docs.dify.ai/en/self-host/use-dify/nodes/variable-assigner",
    "parameter_extractor": "https://docs.dify.ai/en/self-host/use-dify/nodes/parameter-extractor",
    "llm": "https://docs.dify.ai/en/self-host/use-dify/nodes/llm",
    "answer": "https://docs.dify.ai/en/self-host/use-dify/nodes/answer",
    "user_input": "https://docs.dify.ai/en/self-host/use-dify/nodes/user-input",
    "export_import": "https://docs.dify.ai/en/self-host/use-dify/workspace/export-import-apps"
  },
  "app": {
    "name": "EV",
    "mode": "chatflow",
    "language": "zh-CN (English technical terms kept)",
    "description": "新能源汽车维修学习助手：故障问诊与排查方向、知识问答（带引用）、维修英语术语",
    "example_brands": [
      "Tesla",
      "GAC Aion",
      "BYD",
      "Toyota",
      "Nissan",
      "Honda",
      "Volkswagen ID.",
      "BMW i",
      "Mercedes-Benz EQ"
    ],
    "features": {
      "citation_and_attributions": true,
      "content_moderation": "optional, not configured"
    }
  },
  "knowledge_bases": [
    {
      "name": "ev-knowledge",
      "files": [
        "knowledge/01-fault-intake.md",
        "knowledge/02-ev-basics.md",
        "knowledge/03-safety-hv.md",
        "knowledge/05-australia-notes.md"
      ]
    },
    {
      "name": "ev-glossary",
      "files": [
        "knowledge/04-glossary-en.md"
      ]
    }
  ],
  "conversation_variables": [
    {
      "name": "brand",
      "type": "string",
      "default": ""
    },
    {
      "name": "vehicle_model",
      "type": "string",
      "default": ""
    },
    {
      "name": "model_year",
      "type": "string",
      "default": ""
    },
    {
      "name": "powertrain",
      "type": "string",
      "default": ""
    },
    {
      "name": "mileage",
      "type": "string",
      "default": ""
    },
    {
      "name": "power_state",
      "type": "string",
      "default": ""
    },
    {
      "name": "symptom",
      "type": "string",
      "default": ""
    },
    {
      "name": "warning_info",
      "type": "string",
      "default": ""
    },
    {
      "name": "recent_events",
      "type": "string",
      "default": ""
    }
  ],
  "required_slots": [
    "brand",
    "vehicle_model",
    "power_state",
    "symptom"
  ],
  "intent_labels": [
    "fault",
    "knowledge",
    "english",
    "unsafe_hv",
    "out_of_scope"
  ],
  "nodes": [
    {
      "id": "start",
      "type": "User Input",
      "title": "开始",
      "outputs": [
        "userinput.query (older UIs: sys.query)"
      ]
    },
    {
      "id": "llm_classify",
      "type": "LLM",
      "title": "意图分类",
      "prompt_ref": "docs/system-prompts.md#§2",
      "input": "userinput.query",
      "memory": true,
      "temperature_hint": "low",
      "outputs": [
        "text"
      ],
      "alternative": {
        "type": "Question Classifier",
        "note": "Define 5 classes using label definitions from §2; put HV-priority rule in Instructions; removes need for if_route."
      }
    },
    {
      "id": "if_route",
      "type": "If-Else",
      "title": "分流",
      "cases": [
        {
          "case": "IF",
          "variable": "llm_classify.text",
          "operator": "contains",
          "value": "unsafe_hv",
          "target": "llm_refusal"
        },
        {
          "case": "ELIF",
          "variable": "llm_classify.text",
          "operator": "contains",
          "value": "fault",
          "target": "pe_slots"
        },
        {
          "case": "ELIF",
          "variable": "llm_classify.text",
          "operator": "contains",
          "value": "knowledge",
          "target": "kr_knowledge"
        },
        {
          "case": "ELIF",
          "variable": "llm_classify.text",
          "operator": "contains",
          "value": "english",
          "target": "kr_glossary"
        },
        {
          "case": "ELSE",
          "target": "llm_refusal",
          "note": "out_of_scope or unexpected output"
        }
      ]
    },
    {
      "id": "pe_slots",
      "type": "Parameter Extractor",
      "title": "槽位提取",
      "input": "userinput.query",
      "instruction_ref": "docs/system-prompts.md#§3",
      "parameters": [
        {
          "name": "brand",
          "type": "string",
          "required": false
        },
        {
          "name": "vehicle_model",
          "type": "string",
          "required": false
        },
        {
          "name": "model_year",
          "type": "string",
          "required": false
        },
        {
          "name": "powertrain",
          "type": "string",
          "required": false
        },
        {
          "name": "mileage",
          "type": "string",
          "required": false
        },
        {
          "name": "power_state",
          "type": "string",
          "required": false
        },
        {
          "name": "symptom",
          "type": "string",
          "required": false
        },
        {
          "name": "warning_info",
          "type": "string",
          "required": false
        },
        {
          "name": "recent_events",
          "type": "string",
          "required": false
        }
      ],
      "outputs": [
        "brand",
        "vehicle_model",
        "model_year",
        "powertrain",
        "mileage",
        "power_state",
        "symptom",
        "warning_info",
        "recent_events",
        "__is_success",
        "__reason"
      ]
    },
    {
      "id": "code_merge_slots",
      "type": "Code",
      "title": "合并槽位",
      "language": "python3",
      "purpose": "Merge new slots from pe_slots with old conversation values: if pe_slots.__is_success == 0, keep ALL old values; otherwise use the new value only when it is non-empty (after strip), else keep the old value. Prevents Variable Assigner Overwrite from clearing slots.",
      "inputs": [
        {
          "name": "is_success",
          "source": "pe_slots.__is_success"
        },
        {
          "name": "new_brand",
          "source": "pe_slots.brand"
        },
        {
          "name": "new_vehicle_model",
          "source": "pe_slots.vehicle_model"
        },
        {
          "name": "new_model_year",
          "source": "pe_slots.model_year"
        },
        {
          "name": "new_powertrain",
          "source": "pe_slots.powertrain"
        },
        {
          "name": "new_mileage",
          "source": "pe_slots.mileage"
        },
        {
          "name": "new_power_state",
          "source": "pe_slots.power_state"
        },
        {
          "name": "new_symptom",
          "source": "pe_slots.symptom"
        },
        {
          "name": "new_warning_info",
          "source": "pe_slots.warning_info"
        },
        {
          "name": "new_recent_events",
          "source": "pe_slots.recent_events"
        },
        {
          "name": "old_brand",
          "source": "conversation.brand"
        },
        {
          "name": "old_vehicle_model",
          "source": "conversation.vehicle_model"
        },
        {
          "name": "old_model_year",
          "source": "conversation.model_year"
        },
        {
          "name": "old_powertrain",
          "source": "conversation.powertrain"
        },
        {
          "name": "old_mileage",
          "source": "conversation.mileage"
        },
        {
          "name": "old_power_state",
          "source": "conversation.power_state"
        },
        {
          "name": "old_symptom",
          "source": "conversation.symptom"
        },
        {
          "name": "old_warning_info",
          "source": "conversation.warning_info"
        },
        {
          "name": "old_recent_events",
          "source": "conversation.recent_events"
        }
      ],
      "outputs": [
        {
          "name": "brand",
          "type": "string"
        },
        {
          "name": "vehicle_model",
          "type": "string"
        },
        {
          "name": "model_year",
          "type": "string"
        },
        {
          "name": "powertrain",
          "type": "string"
        },
        {
          "name": "mileage",
          "type": "string"
        },
        {
          "name": "power_state",
          "type": "string"
        },
        {
          "name": "symptom",
          "type": "string"
        },
        {
          "name": "warning_info",
          "type": "string"
        },
        {
          "name": "recent_events",
          "type": "string"
        }
      ],
      "code": "SLOTS = [\"brand\", \"vehicle_model\", \"model_year\", \"powertrain\", \"mileage\",\n         \"power_state\", \"symptom\", \"warning_info\", \"recent_events\"]\n\n\ndef _clean(v):\n    if v is None:\n        return \"\"\n    return str(v).strip()\n\n\ndef main(is_success,\n         new_brand, new_vehicle_model, new_model_year, new_powertrain, new_mileage,\n         new_power_state, new_symptom, new_warning_info, new_recent_events,\n         old_brand, old_vehicle_model, old_model_year, old_powertrain, old_mileage,\n         old_power_state, old_symptom, old_warning_info, old_recent_events) -> dict:\n    args = dict(locals())\n    # 提取失败（__is_success == 0）时，9 个槽位全部沿用旧值\n    failed = _clean(is_success) in (\"0\", \"0.0\", \"False\", \"false\")\n    out = {}\n    for k in SLOTS:\n        old = _clean(args.get(\"old_\" + k))\n        new = _clean(args.get(\"new_\" + k))\n        # 新值为空 → 保留旧值；否则用新值\n        out[k] = old if (failed or not new) else new\n    return out\n",
      "code_ref": "docs/workflow-nodes.md#2.1",
      "note": "Design only; logic unit-checked locally with plain python3, not run in Dify."
    },
    {
      "id": "va_slots",
      "type": "Variable Assigner",
      "title": "保存槽位",
      "assignments": [
        {
          "variable": "conversation.brand",
          "operation": "overwrite",
          "source": "code_merge_slots.brand"
        },
        {
          "variable": "conversation.vehicle_model",
          "operation": "overwrite",
          "source": "code_merge_slots.vehicle_model"
        },
        {
          "variable": "conversation.model_year",
          "operation": "overwrite",
          "source": "code_merge_slots.model_year"
        },
        {
          "variable": "conversation.powertrain",
          "operation": "overwrite",
          "source": "code_merge_slots.powertrain"
        },
        {
          "variable": "conversation.mileage",
          "operation": "overwrite",
          "source": "code_merge_slots.mileage"
        },
        {
          "variable": "conversation.power_state",
          "operation": "overwrite",
          "source": "code_merge_slots.power_state"
        },
        {
          "variable": "conversation.symptom",
          "operation": "overwrite",
          "source": "code_merge_slots.symptom"
        },
        {
          "variable": "conversation.warning_info",
          "operation": "overwrite",
          "source": "code_merge_slots.warning_info"
        },
        {
          "variable": "conversation.recent_events",
          "operation": "overwrite",
          "source": "code_merge_slots.recent_events"
        }
      ],
      "note": "All 9 rows Overwrite with the merged result from code_merge_slots (not directly from pe_slots)."
    },
    {
      "id": "if_slots",
      "type": "If-Else",
      "title": "信息是否齐全",
      "cases": [
        {
          "case": "IF",
          "logic": "AND",
          "conditions": [
            {
              "variable": "conversation.brand",
              "operator": "is not empty"
            },
            {
              "variable": "conversation.vehicle_model",
              "operator": "is not empty"
            },
            {
              "variable": "conversation.power_state",
              "operator": "is not empty"
            },
            {
              "variable": "conversation.power_state",
              "operator": "not contains",
              "value": "不确定"
            },
            {
              "variable": "conversation.symptom",
              "operator": "is not empty"
            }
          ],
          "target": "kr_fault",
          "note": "NB2: power_state='不确定' does NOT count as complete -> goes to kr_intake/llm_intake for a follow-up question about READY. No ask-count cap (chosen design: condition only)."
        },
        {
          "case": "ELSE",
          "target": "kr_intake"
        }
      ]
    },
    {
      "id": "kr_intake",
      "type": "Knowledge Retrieval",
      "title": "问诊清单检索（可选）",
      "query": "userinput.query",
      "knowledge": [
        "ev-knowledge"
      ],
      "optional": true,
      "metadata_filter_hint": "01-fault-intake only (optional)",
      "top_k_hint": "3-5, untested",
      "outputs": [
        "result"
      ]
    },
    {
      "id": "llm_intake",
      "type": "LLM",
      "title": "信息收集",
      "context": "kr_intake.result",
      "memory": true,
      "prompt_ref": "docs/system-prompts.md#§4",
      "outputs": [
        "text"
      ]
    },
    {
      "id": "kr_fault",
      "type": "Knowledge Retrieval",
      "title": "排查资料检索",
      "query": "userinput.query",
      "knowledge": [
        "ev-knowledge"
      ],
      "top_k_hint": "3-5, untested",
      "outputs": [
        "result"
      ]
    },
    {
      "id": "llm_troubleshoot",
      "type": "LLM",
      "title": "排查方向",
      "context": "kr_fault.result",
      "memory": true,
      "prompt_ref": "docs/system-prompts.md#§5",
      "outputs": [
        "text"
      ]
    },
    {
      "id": "kr_knowledge",
      "type": "Knowledge Retrieval",
      "title": "知识检索",
      "query": "userinput.query",
      "knowledge": [
        "ev-knowledge"
      ],
      "top_k_hint": "3-5, untested",
      "outputs": [
        "result"
      ]
    },
    {
      "id": "llm_knowledge",
      "type": "LLM",
      "title": "知识问答（带引用）",
      "context": "kr_knowledge.result",
      "memory": true,
      "prompt_ref": "docs/system-prompts.md#§6",
      "outputs": [
        "text"
      ]
    },
    {
      "id": "kr_glossary",
      "type": "Knowledge Retrieval",
      "title": "术语检索",
      "query": "userinput.query",
      "knowledge": [
        "ev-glossary"
      ],
      "top_k_hint": "3-5, untested",
      "outputs": [
        "result"
      ]
    },
    {
      "id": "llm_english",
      "type": "LLM",
      "title": "术语+例句+对话",
      "context": "kr_glossary.result",
      "memory": true,
      "prompt_ref": "docs/system-prompts.md#§7",
      "outputs": [
        "text"
      ]
    },
    {
      "id": "llm_refusal",
      "type": "LLM",
      "title": "安全拒答模板",
      "inputs": [
        "userinput.query",
        "llm_classify.text"
      ],
      "memory": false,
      "prompt_ref": "docs/system-prompts.md#§8",
      "outputs": [
        "text"
      ]
    },
    {
      "id": "ans_intake",
      "type": "Answer",
      "content": "{{#llm_intake.text#}}"
    },
    {
      "id": "ans_troubleshoot",
      "type": "Answer",
      "content": "{{#llm_troubleshoot.text#}}"
    },
    {
      "id": "ans_knowledge",
      "type": "Answer",
      "content": "{{#llm_knowledge.text#}}"
    },
    {
      "id": "ans_english",
      "type": "Answer",
      "content": "{{#llm_english.text#}}"
    },
    {
      "id": "ans_refusal",
      "type": "Answer",
      "content": "{{#llm_refusal.text#}}"
    }
  ],
  "edges": [
    [
      "start",
      "llm_classify"
    ],
    [
      "llm_classify",
      "if_route"
    ],
    [
      "if_route:unsafe_hv",
      "llm_refusal"
    ],
    [
      "if_route:fault",
      "pe_slots"
    ],
    [
      "if_route:knowledge",
      "kr_knowledge"
    ],
    [
      "if_route:english",
      "kr_glossary"
    ],
    [
      "if_route:else",
      "llm_refusal"
    ],
    [
      "pe_slots",
      "code_merge_slots"
    ],
    [
      "code_merge_slots",
      "va_slots"
    ],
    [
      "va_slots",
      "if_slots"
    ],
    [
      "if_slots:complete",
      "kr_fault"
    ],
    [
      "if_slots:else",
      "kr_intake"
    ],
    [
      "kr_intake",
      "llm_intake"
    ],
    [
      "llm_intake",
      "ans_intake"
    ],
    [
      "kr_fault",
      "llm_troubleshoot"
    ],
    [
      "llm_troubleshoot",
      "ans_troubleshoot"
    ],
    [
      "kr_knowledge",
      "llm_knowledge"
    ],
    [
      "llm_knowledge",
      "ans_knowledge"
    ],
    [
      "kr_glossary",
      "llm_english"
    ],
    [
      "llm_english",
      "ans_english"
    ],
    [
      "llm_refusal",
      "ans_refusal"
    ]
  ],
  "error_handling": {
    "llm_nodes": "Enable retry; fallback default value text",
    "default_text": "抱歉，系统暂时没能生成回答。请稍后再试；涉及安全的问题请直接咨询有资质的技师。"
  },
  "test_cases_ref": "docs/test-cases.md",
  "safety_block": {
    "ref": "docs/system-prompts.md#§1",
    "embedded_in_prompts": [
      "llm_intake (§4)",
      "llm_troubleshoot (§5)",
      "llm_knowledge (§6)",
      "llm_english (§7)",
      "llm_refusal (§8)"
    ],
    "not_embedded": {
      "llm_classify (§2)": "label-only output",
      "pe_slots (§3)": "parameter extraction, does not answer the user"
    },
    "rule_count": 8,
    "rule_8_emergency": "紧急情况（冒烟、异味、起火、漏液等）立即远离车辆并联系专业救援。"
  }
}
